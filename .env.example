# Tempo Cloud credentials stay local. Copy this file to .env and fill it in.
TEMPO_TOKEN=

# Optional overrides. Non-secret Tempo settings can also be stored with `flog setup`.
# TEMPO_API_URL=https://api.tempo.io/4/worklogs
# TEMPO_ISSUE_ID=12345
# TEMPO_ISSUE_KEY=PROJ-123
# TEMPO_AUTHOR_ACCOUNT_ID=712020:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# TEMPO_DESCRIPTION_FORMAT={id} - {desc}
# TEMPO_BILLABLE_MODE=equal
# TEMPO_ATTRIBUTES=[{"key":"_Account_","value":"Users"}]

# Useful for tests or custom storage locations.
# FLOG_DATA_DIR=./worklogs
# FLOG_CONFIG_DIR=./.flog-config
